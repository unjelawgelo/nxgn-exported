# Copy this to .env and fill in values
PORT=4000

PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=
# Either paste the CA certificate content here, or provide a file path via PG_SSL_CA_PATH
PG_SSL_CA=
# If you prefer to load CA from a file, set this to an absolute path (overrides PG_SSL_CA)
PG_SSL_CA_PATH=
